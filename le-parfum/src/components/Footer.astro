---
import config from '../data/config.json';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__trust">
    <div class="trust-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M12 2l7 3v6c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V5l7-3z" />
        <path d="M9 12l2 2 4-4" />
      </svg>
      <span>100% originales</span>
    </div>
    <div class="trust-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M3 7h13v9H3z" />
        <path d="M16 10h3l2 2.5V16h-5z" />
        <circle cx="7.5" cy="18" r="1.5" />
        <circle cx="17.5" cy="18" r="1.5" />
      </svg>
      <span>Envío a todo Costa Rica</span>
    </div>
    <div class="trust-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="M3 9h18" />
        <path d="M7 14h4" />
      </svg>
      <span>Pago fácil por SINPE o tarjeta</span>
    </div>
  </div>

  <div class="footer__main">
    <div class="footer__col">
      <p class="footer__logo">Le Parfum</p>
      <p class="footer__tagline">Fragancias exclusivas, elegancia y calidad en cada detalle.</p>
      <div class="footer__socials">
        {config.instagram && (
          <a href={config.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none" />
            </svg>
          </a>
        )}
        {config.tiktok && (
          <a href={config.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M14 4v9.5a3.5 3.5 0 1 1-3-3.46" />
              <path d="M14 4c.3 2.2 2 3.8 4 4" />
            </svg>
          </a>
        )}
      </div>
    </div>

    <nav class="footer__col" aria-label="Enlaces">
      <p class="footer__heading">Tienda</p>
      <a href="/#catalogo">Catálogo</a>
      <a href="/nosotros">Nosotros</a>
      <a href="/preguntas-frecuentes">Preguntas frecuentes</a>
      <a href="/politica-de-envios">Envíos y devoluciones</a>
    </nav>

    <nav class="footer__col" aria-label="Legal">
      <p class="footer__heading">Legal</p>
      <a href="/terminos">Términos y condiciones</a>
      <a href="/privacidad">Política de privacidad</a>
    </nav>

    <div class="footer__col">
      <p class="footer__heading">Contacto</p>
      {config.email && <a href={`mailto:${config.email}`}>{config.email}</a>}
      {config.telefono && <a href={`tel:${config.telefono}`}>{config.telefono}</a>}
      {config.direccion && <p class="footer__text">{config.direccion}</p>}
      {config.horario && <p class="footer__text">{config.horario}</p>}
    </div>
  </div>

  <div class="footer__bottom">
    <p>&copy; {year} {config.razonSocial || 'Le Parfum'}. Todos los derechos reservados.</p>
    {config.cedulaJuridica && <p>Cédula jurídica {config.cedulaJuridica}</p>}
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-2xl);
    background: var(--color-bg-elevated);
    border-top: 1px solid var(--color-border);
  }

  .footer__trust {
    max-width: 1400px;
    margin-inline: auto;
    padding: var(--space-md) clamp(1.25rem, 4vw, 4rem);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .trust-item svg {
    color: var(--color-accent-dark);
    flex-shrink: 0;
  }

  .footer__main {
    max-width: 1400px;
    margin-inline: auto;
    padding: var(--space-xl) clamp(1.25rem, 4vw, 4rem);
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: var(--space-lg);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer__logo {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 2.6vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0 0 0.1em;
  }

  .footer__tagline {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    max-width: 32ch;
  }

  .footer__socials {
    display: flex;
    gap: var(--space-sm);
    margin-top: 0.5rem;
  }

  .footer__socials a {
    color: var(--color-text);
    display: flex;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .footer__socials a:hover {
    color: var(--color-accent-dark);
  }

  .footer__heading {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 0.3rem;
  }

  .footer__col a,
  .footer__text {
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
    margin: 0;
  }

  .footer__text {
    color: var(--color-text-muted);
  }

  .footer__col a:hover {
    color: var(--color-accent-dark);
  }

  .footer__bottom {
    max-width: 1400px;
    margin-inline: auto;
    padding: var(--space-sm) clamp(1.25rem, 4vw, 4rem) var(--space-lg);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
  }

  .footer__bottom p {
    margin: 0;
  }

  @media (max-width: 800px) {
    .footer__main {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .footer__main {
      grid-template-columns: 1fr;
    }
  }
</style>
