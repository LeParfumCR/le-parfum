---
import collageImage from '../assets/brand/bestsellers-collage.webp';
import monogramImage from '../assets/brand/le-parfum-monogram.webp';

interface Props {
  nombre: string;
  precio: number;
  moneda: string;
  imagen: string;
  slug: string;
  marca?: string;
}

const { nombre, precio, moneda, slug, marca = 'Maison sélectionnée' } = Astro.props;
const precioFormateado = new Intl.NumberFormat('es-CR', {
  style: 'currency', currency: moneda, maximumFractionDigits: 0,
}).format(precio);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__grain" aria-hidden="true"></div>
  <div class="hero__ambient hero__ambient--one" aria-hidden="true"></div>
  <div class="hero__ambient hero__ambient--two" aria-hidden="true"></div>

  <div class="hero__content">
    <p class="hero__kicker"><span></span> Perfumería selecta · Costa Rica</p>
    <h1 id="hero-title">El aroma<br /><em>que te representa.</em></h1>
    <p class="hero__lead">Una selección de perfumes originales para convertir cada llegada, encuentro y recuerdo en algo imposible de ignorar.</p>

    <div class="hero__actions">
      <a href="#catalogo" class="button button--primary">Explorar perfumes <span>↗</span></a>
      <a href={`/producto/${slug}`} class="button button--ghost">Selección del mes</a>
    </div>

    <div class="hero__proof">
      <div><strong>100%</strong><span>Originales</span></div>
      <div><strong>CR</strong><span>Envíos nacionales</span></div>
      <div><strong>1:1</strong><span>Asesoría personal</span></div>
    </div>
  </div>

  <div class="hero__visual">
    <div class="hero__monogram-wrap" aria-hidden="true">
      <img src={monogramImage.src} alt="" class="hero__monogram" width="776" height="602" />
    </div>

    <div class="hero__edition"><span>LE PARFUM</span><small>COLLECTION N° 01</small></div>

<div class="hero__stage">
  <div class="hero__luxury-glow"></div>
  <div class="hero__halo"></div>
  <img
    src={collageImage.src}
        alt="Selección de perfumes más vendidos de Le Parfum"
        class="hero__collage"
        fetchpriority="high"
        decoding="async"
        width="615"
        height="409"
      />
      <span class="hero__floor" aria-hidden="true"></span>
    </div>

    <a href={`/producto/${slug}`} class="hero__product-card" aria-label={`Ver ${nombre}`}>
      <div>
        <p>{marca}</p>
        <h2>{nombre}</h2>
      </div>
      <strong>{precioFormateado}</strong>
      <span class="hero__arrow">↗</span>
    </a>

    <p class="hero__signature">Tus favoritos.<br /><em>Una sola colección.</em></p>
  </div>

  <div class="hero__scroll"><span></span> Descubrir</div>
</section>

<style>
  .hero{min-height:min(900px,calc(100svh - 16px));max-width:1540px;margin:0 auto;padding:clamp(3rem,7vw,6.5rem) clamp(1.25rem,4vw,4.5rem) 3rem;display:grid;grid-template-columns:minmax(0,.9fr) minmax(480px,1.1fr);align-items:center;gap:clamp(2rem,4vw,5rem);position:relative;overflow:hidden;isolation:isolate}
  .hero__grain{position:absolute;inset:0;z-index:-1;opacity:.18;pointer-events:none;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.12'/%3E%3C/svg%3E")}
  .hero__ambient{position:absolute;border-radius:50%;filter:blur(90px);opacity:.42;z-index:-2;pointer-events:none}.hero__ambient--one{width:420px;height:420px;background:#ddc29b;top:2%;left:-15%}.hero__ambient--two{width:520px;height:520px;background:#b8c5bd;right:-16%;bottom:-22%}
  .hero__content{position:relative;z-index:3;animation:reveal .9s var(--ease-luxury) both}.hero__kicker{display:flex;align-items:center;gap:.7rem;margin:0 0 1.5rem;font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--color-text-muted)}.hero__kicker span{width:34px;height:1px;background:var(--color-accent-dark)}
  h1{font-size:clamp(4.2rem,8vw,8rem);line-height:.79;letter-spacing:-.058em;max-width:8.4ch;font-weight:500}h1 em{font-weight:400;color:var(--color-accent-dark)}.hero__lead{max-width:50ch;margin:2rem 0;color:var(--color-text-muted);font-size:clamp(1rem,1.3vw,1.14rem)}
  .hero__actions{display:flex;flex-wrap:wrap;gap:.75rem}.button{min-height:52px;display:inline-flex;align-items:center;justify-content:center;gap:1.5rem;padding:0 1.4rem;border-radius:999px;text-decoration:none;font-size:.82rem;letter-spacing:.03em;transition:transform .35s var(--ease-luxury),background .35s,color .35s}.button:hover{transform:translateY(-3px)}.button--primary{background:var(--color-text);color:var(--color-bg)}.button--primary span{font-size:1.1rem}.button--ghost{border:1px solid var(--color-border-strong);backdrop-filter:blur(12px)}
  .hero__proof{display:flex;gap:clamp(1.4rem,3vw,3rem);margin-top:clamp(2.7rem,6vw,5rem)}.hero__proof div{display:flex;flex-direction:column;gap:.15rem}.hero__proof strong{font-family:var(--font-display);font-size:1.4rem;font-weight:500}.hero__proof span{color:var(--color-text-muted);font-size:.67rem;text-transform:uppercase;letter-spacing:.1em}
  .hero__visual{position:relative;min-height:clamp(560px,67vw,760px);display:grid;place-items:center;animation:reveal 1s .12s var(--ease-luxury) both}.hero__monogram-wrap{position:absolute;inset:7% 5% 4% 10%;display:grid;place-items:center;opacity:.075;transform:rotate(-5deg);pointer-events:none}.hero__monogram{width:min(92%,680px);height:auto;filter:contrast(1.2)}
  .hero__edition{position:absolute;top:8%;right:2%;display:flex;flex-direction:column;align-items:flex-end;gap:.2rem;z-index:2}.hero__edition span{font-family:var(--font-display);font-size:1.1rem;letter-spacing:.08em}.hero__edition small{font-size:.58rem;letter-spacing:.2em;color:var(--color-text-muted)}
  .hero__stage{width:min(96%,760px);aspect-ratio:1.15;position:relative;display:grid;place-items:center;transform:translateY(1.8rem)}.hero__halo{position:absolute;width:72%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 45% 42%,rgba(255,255,255,.88),rgba(232,218,195,.52) 45%,transparent 72%);filter:blur(1px);box-shadow:0 0 90px rgba(185,151,104,.16)}
 .hero__collage{

  position:relative;

  z-index:2;

  width:95%;

  height:auto;

  object-fit:contain;

  filter:
    drop-shadow(0 32px 30px rgba(34,28,22,.19));

  transition:
    transform 1s var(--ease-luxury),
    filter .8s ease;

}
  .hero__product-card{position:absolute;left:0;bottom:7%;z-index:4;width:min(350px,55%);padding:1.05rem 3rem 1.05rem 1.2rem;display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;border:1px solid rgba(255,255,255,.5);background:color-mix(in srgb,var(--color-bg-elevated) 76%,transparent);backdrop-filter:blur(24px) saturate(1.4);border-radius:18px;box-shadow:0 18px 55px rgba(25,20,15,.13);text-decoration:none;color:inherit;transition:transform .35s var(--ease-luxury),box-shadow .35s}.hero__product-card:hover{transform:translateY(-5px);box-shadow:0 24px 65px rgba(25,20,15,.18)}.hero__product-card p{margin:0 0 .2rem;font-size:.62rem;letter-spacing:.13em;text-transform:uppercase;color:var(--color-text-muted)}.hero__product-card h2{font-size:1.45rem;line-height:1}.hero__product-card strong{white-space:nowrap;font-size:.76rem;font-weight:500}.hero__arrow{position:absolute;right:1rem;top:1rem;font-size:1.05rem}
  .hero__signature{position:absolute;right:0;bottom:9%;z-index:3;font-family:var(--font-display);font-size:clamp(1.15rem,2vw,1.55rem);line-height:1.04;text-align:right}.hero__signature em{color:var(--color-accent-dark)}.hero__scroll{position:absolute;left:clamp(1.25rem,4vw,4.5rem);bottom:1.8rem;display:flex;gap:.7rem;align-items:center;font-size:.63rem;letter-spacing:.16em;text-transform:uppercase;color:var(--color-text-muted)}.hero__scroll span{width:34px;height:1px;background:currentColor}
  [data-theme='dark'] .hero__monogram{filter:invert(1);opacity:.85}[data-theme='dark'] .hero__halo{opacity:.55}
  .hero__luxury-glow{

  position:absolute;

  width:90%;

  aspect-ratio:1;

  border-radius:50%;

  pointer-events:none;

  opacity:0;

  transition:
    opacity .8s var(--ease-luxury);

  background:
    radial-gradient(
      circle,
      rgba(226,191,132,.25),
      rgba(226,191,132,.10) 40%,
      transparent 75%
    );

  filter:
    blur(120px);

}
[data-theme='dark'] .hero__luxury-glow{

  opacity:1;

}

  @keyframes reveal{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}
  @media(max-width:980px){.hero{grid-template-columns:1fr;min-height:auto;padding-top:2.5rem;gap:0}.hero__content{text-align:center}.hero__kicker,.hero__actions,.hero__proof{justify-content:center}h1{margin:auto;max-width:9ch;font-size:clamp(3.8rem,16vw,6.5rem)}.hero__lead{margin:1.5rem auto 2rem}.hero__visual{min-height:620px}.hero__scroll{display:none}.hero__edition{right:6%}}
  @media(max-width:560px){.hero{padding-inline:1rem}.hero__visual{min-height:455px;margin-top:1rem}.hero__stage{width:116%;transform:translateY(-.25rem)}.hero__collage{width:100%}.hero__monogram-wrap{inset:4% -10% 2%}.hero__edition{top:0;right:0}.hero__product-card{left:0;bottom:1%;width:72%;padding-right:2.5rem}.hero__signature{display:none}.hero__proof{gap:1rem}.hero__proof span{font-size:.56rem}.button{width:100%}.hero__floor{bottom:18%}}
  @media(prefers-reduced-motion:reduce){.hero__content,.hero__visual{animation:none}.hero__collage{transition:none}}
</style>
